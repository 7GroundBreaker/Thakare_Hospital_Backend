# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

# --- Core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database (leave DATABASE_ENGINE unset to use SQLite locally) -----
# DATABASE_ENGINE=postgres
# POSTGRES_DB=thakare_hospital
# POSTGRES_USER=thakare_hospital
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- CORS / CSRF (Next.js frontend origin) -----------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Object storage (S3-compatible). Leave USE_S3=false for local disk -
USE_S3=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=

# --- Email ---------------------------------------------------------------
# Defaults to printing emails to the console in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@thakarehospital.example
HOSPITAL_ADMIN_NOTIFICATION_EMAIL=

# --- WhatsApp (disabled until a provider is configured) -----------------
WHATSAPP_PROVIDER_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Uploads --------------------------------------------------------------
APPOINTMENT_MAX_UPLOAD_MB=10
APPOINTMENT_ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png

# --- Google Maps (also used by the Next.js frontend) ----------------------
GOOGLE_MAPS_API_KEY=
